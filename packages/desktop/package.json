{
  "name": "@roughdraft/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "productName": "Roughdraft",
  "scripts": {
    "build": "tsc && pnpm build:preload",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "package": "pnpm build && electron-forge package",
    "start": "pnpm build && electron .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@types/node": "^22.15.0",
    "electron": "42.5.2",
    "esbuild": "0.27.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
